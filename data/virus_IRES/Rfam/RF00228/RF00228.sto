#=GF ID IRES_HepA
#=GF AC RF00228
#=GF DE Hepatitis A virus internal ribosome entry site (IRES)
#=GF AU Moxon SJ; 0000-0003-4644-1816
#=GF GA 55.0
#=GF NC 37.5
#=GF TC 688.5
#=GF PI HepA_IRES
#=GF SE http://ifr31w3.toulouse.inserm.fr/IRESdatabase/
#=GF SS Predicted; PFOLD
#=GF TP Cis-reg; IRES;
#=GF BM cmbuild -F CM SEED
#=GF CB cmcalibrate --mpi CM
#=GF SM cmsearch --cpu 4 --verbose --nohmmonly -T 19.20 -Z 2958934 CM SEQDB
#=GF DR SO; 0000243; internal_ribosome_entry_site;
#=GF DR GO; 0043022; ribosome binding;
#=GF RN [1]
#=GF RM 8289336
#=GF RT In vitro characterization of an internal ribosomal entry site (IRES)
#=GF RT present within the 5' nontranslated region of hepatitis A virus RNA:
#=GF RT comparison with the IRES of encephalomyocarditis virus.
#=GF RA Brown EA, Zajac AJ, Lemon SM
#=GF RL J Virol 1994;68:1066-1074.
#=GF RN [2]
#=GF RM 11142379
#=GF RT Ribosomal binding to the internal ribosomal entry site of classical swine
#=GF RT fever virus.
#=GF RA Kolupaeva VG, Pestova TV, Hellen CU
#=GF RL RNA 2000;6:1791-1807.
#=GF CC This family represents the internal ribosome entry site (IRES) of the the
#=GF CC Hepatitis A virus. IRES elements allow cap and end-independent translation
#=GF CC of mRNA in the host cell. The IRES achieves this by mediating the internal
#=GF CC initiation of translation by recruiting a ribosomal 43S pre-initiation
#=GF CC complex directly to the initiation codon and eliminates the requirement
#=GF CC for eIF4F [2].
#=GF WK Hepatitis_A_virus_internal_ribosome_entry_site_(IRES)
#=GF SQ 23

